% =====================================================================
%  estilo-apuntes.sty — Estilo común de los apuntes «Anatomía de un LLM»
%  Compilar con XeLaTeX (latexmk -xelatex). En TeX Live completo u Overleaf la partición
%  silábica del español está disponible; aquí se usa el formato fmt/xelatex-es.fmt.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo-apuntes}[2026/10/19 Apuntes Anatomia de un LLM]

% --- Idioma y tipografía -------------------------------------------------
\RequirePackage[no-math]{fontspec}
\setmainfont{Latin Modern Roman}[SmallCapsFont={Latin Modern Roman Caps}]
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}
\RequirePackage{babel}
\babelprovide[import,main]{spanish}
\setlocalecaption{spanish}{chapter}{Tema}
\setlocalecaption{spanish}{contents}{Índice}
\setlocalecaption{spanish}{bib}{Bibliografía}
\setlocalecaption{spanish}{appendix}{Apéndice}
\RequirePackage{microtype}

% --- Página -------------------------------------------------------------
\RequirePackage[a4paper,top=2.8cm,bottom=2.8cm,inner=2.7cm,outer=2.7cm,headheight=14pt]{geometry}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0.25\baselineskip plus 2pt}
\linespread{1.04}
\setlength{\emergencystretch}{1.5em}
\raggedbottom

% --- Matemáticas --------------------------------------------------------
\RequirePackage{amsmath,amssymb,amsthm,mathtools,bm}
\RequirePackage{thmtools}
\RequirePackage{booktabs,array,tabularx}
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=4pt}
\setlist[enumerate,1]{label=(\roman*)}
\RequirePackage{tikz}
\usetikzlibrary{automata,positioning,arrows.meta,decorations.pathreplacing,calc,shapes.geometric,fit}
\RequirePackage{xcolor}
\definecolor{tinta}{gray}{0.12}
\definecolor{regla}{gray}{0.55}
\definecolor{enlace}{RGB}{20,50,120}

% --- Cabeceras ----------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{\thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection.\ #1}}
\fancyhead[LE]{\small\scshape\ApuntesCurso\ \textperiodcentered\ \ApuntesModulo}
\fancyhead[RO]{\small\itshape\nouppercase{\leftmark}}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}

% --- Títulos ------------------------------------------------------------
\RequirePackage{titlesec}
\titleformat{\chapter}[display]{\normalfont\raggedright}{\large\scshape\chaptertitlename\ \thechapter}{4pt}{\titlerule[0.8pt]\vspace{6pt}\Huge\bfseries}[{\vspace{4pt}\titlerule[0.4pt]}]
\titlespacing*{\chapter}{0pt}{10pt}{28pt}
\titleformat{\section}{\normalfont\Large\bfseries}{\thesection}{0.8em}{}
\titleformat{\subsection}{\normalfont\large\bfseries}{\thesubsection}{0.8em}{}
\titlespacing*{\section}{0pt}{18pt plus 4pt}{8pt}
\titlespacing*{\subsection}{0pt}{12pt plus 3pt}{6pt}

% --- Enunciados ---------------------------------------------------------
\declaretheoremstyle[headfont=\bfseries,bodyfont=\normalfont,spaceabove=8pt,spacebelow=8pt,notefont=\bfseries,notebraces={(}{)}]{defin}
\declaretheoremstyle[headfont=\bfseries,bodyfont=\itshape,spaceabove=8pt,spacebelow=8pt,notefont=\bfseries,notebraces={(}{)}]{teor}
\declaretheoremstyle[headfont=\itshape,bodyfont=\normalfont,spaceabove=6pt,spacebelow=6pt]{obs}
\declaretheorem[style=defin,name=Definición,numberwithin=chapter]{definicion}
\declaretheorem[style=teor,name=Teorema,sibling=definicion]{teorema}
\declaretheorem[style=teor,name=Proposición,sibling=definicion]{proposicion}
\declaretheorem[style=teor,name=Lema,sibling=definicion]{lema}
\declaretheorem[style=teor,name=Corolario,sibling=definicion]{corolario}
\declaretheorem[style=defin,name=Ejemplo,sibling=definicion]{ejemplo}
\declaretheorem[style=obs,name=Observación,sibling=definicion]{observacion}
\renewcommand{\qedsymbol}{$\blacksquare$}
\renewcommand{\proofname}{Demostración}

% --- Ejercicios y soluciones -----------------------------------------
%  \begin{ejercicio}{2}{eje:bigramas}  ... \end{ejercicio}   (dificultad 1–3)
%  \fuente{Texto de la referencia}
%  \begin{solucion}{eje:bigramas} ... \end{solucion}
\newcounter{ejercicio}[chapter]
\renewcommand{\theejercicio}{\thechapter.\arabic{ejercicio}}
\providecommand{\theHejercicio}{}\renewcommand{\theHejercicio}{\thechapter.\arabic{ejercicio}}
\newcommand{\estrellas}[1]{\ifcase#1\or$\star$\or$\star\star$\or$\star\star\star$\fi}
\newenvironment{ejercicio}[2]{%
  \refstepcounter{ejercicio}\label{#2}%
  \par\medskip\noindent
  \hyperref[sol:#2]{\textbf{Ejercicio \theejercicio}}\ \ {\small\estrellas{#1}}\quad\ignorespaces}%
  {\par\medskip}
\newcommand{\fuente}[1]{\par\noindent{\small\textit{Fuente:} #1}}
\newenvironment{solucion}[1]{%
  \par\medskip\noindent
  \phantomsection\label{sol:#1}%
  \hyperref[#1]{\textbf{Solución del ejercicio \ref*{#1}}}\par\nopagebreak\smallskip\ignorespaces}%
  {\par\medskip}
\newcommand{\datos}{\par\noindent\textit{Datos.}\ }
\newcommand{\planteamiento}{\par\noindent\textit{Planteamiento.}\ }
\newcommand{\pasos}{\par\noindent\textit{Desarrollo.}}
\newcommand{\resultado}{\par\noindent\textit{Resultado.}\ }
\newcommand{\comprobacion}{\par\noindent\textit{Comprobación.}\ }

% --- Lecturas del tema --------------------------------------------------
\newenvironment{lecturas}{%
  \par\bigskip\noindent\textbf{Lecturas recomendadas para este tema}\par\nopagebreak\smallskip
  \begin{itemize}[leftmargin=1.4em,label=\textendash]\small}%
  {\end{itemize}}

% --- Notación --------------------------------------------------------------
\newcommand{\V}{\mathcal{V}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\E}{\mathbb{E}}
\newcommand{\PPL}{\operatorname{PPL}}
\newcommand{\softmax}{\operatorname{softmax}}
\newcommand{\LSE}{\operatorname{LSE}}
\newcommand{\fin}{\ensuremath{\langle\texttt{.}\rangle}}
\newcommand{\dec}{{,}}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}

% --- Enlaces ------------------------------------------------------------
\RequirePackage[hidelinks]{hyperref}
\hypersetup{colorlinks=true,linkcolor=enlace,urlcolor=enlace,citecolor=enlace,pdfencoding=auto}
\RequirePackage[spanish,noabbrev]{cleveref}
\crefname{definicion}{definición}{definiciones}
\crefname{teorema}{teorema}{teoremas}
\crefname{proposicion}{proposición}{proposiciones}
\crefname{ejercicio}{ejercicio}{ejercicios}
\crefname{ejemplo}{ejemplo}{ejemplos}
\crefname{chapter}{tema}{temas}
\crefname{appendix}{apéndice}{apéndices}
\crefname{corolario}{corolario}{corolarios}
\crefname{lema}{lema}{lemas}
\crefname{observacion}{observación}{observaciones}

\endinput
